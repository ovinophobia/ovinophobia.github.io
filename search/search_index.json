{"config":{"lang":["zh"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u4e3b\u9875","text":"\u6211\u7684\u7f51\u7ad9\u540d\u79f0"},{"location":"about/","title":"\u5173\u4e8e","text":"<p>\u4f60\u597d\uff0c\u6211\u662f ovino\u3002\u6b22\u8fce\u6765\u5230\u6211\u7684\u4e2a\u4eba\u7f51\u7ad9\uff01</p> <p>\u8fd9\u91cc\u4f1a\u5206\u4eab\u6211\u7684\u8bfe\u7a0b\u7b14\u8bb0\u3001\u5b66\u4e60\u5fc3\u5f97\uff0c\u4ee5\u53ca\u751f\u6d3b\u4e2d\u503c\u5f97\u8bb0\u5f55\u7684\u5c0f\u4e8b\u3002</p>"},{"location":"about/#_2","title":"\u6211\u7684\u5174\u8da3","text":"<ul> <li>\u5b66\u4e60\u65b0\u77e5\u8bc6\uff0c\u6574\u7406\u81ea\u5df1\u7684\u7b14\u8bb0\u3002</li> <li>\u9605\u8bfb\u3001\u601d\u8003\uff0c\u5c1d\u8bd5\u6709\u8da3\u7684\u5c0f\u9879\u76ee\u3002</li> </ul>"},{"location":"about/#_3","title":"\u8054\u7cfb\u6211","text":"<p>\u8fd9\u91cc\u53ef\u4ee5\u586b\u5199\u4f60\u7684\u90ae\u7bb1\u6216\u793e\u4ea4\u8d26\u53f7\u3002</p> <p>\u4ee5\u4e0a\u662f\u81ea\u6211\u4ecb\u7ecd\u5360\u4f4d\u6587\u5b57\uff0c\u53ef\u4ee5\u6309\u7167\u81ea\u5df1\u7684\u60c5\u51b5\u4fee\u6539\u3002</p>"},{"location":"course/","title":"\u8bfe\u7a0b","text":"<p>\u8fd9\u91cc\u8bb0\u5f55\u6211\u7684\u8bfe\u7a0b\u7b14\u8bb0\u4e0e\u5b66\u4e60\u5fc3\u5f97\uff0c\u6b22\u8fce\u4e00\u8d77\u5b66\u4e60\u3001\u6162\u6162\u79ef\u7d2f\u3002</p>"},{"location":"course/#_2","title":"\u6587\u7ae0\u5217\u8868","text":"<ul> <li>\u793a\u4f8b\u8bfe\u7a0b\uff1a\u5982\u4f55\u6574\u7406\u4e00\u7bc7\u5b66\u4e60\u7b14\u8bb0 \u2014 \u4ece\u5b66\u4e60\u76ee\u6807\u5230\u7ec3\u4e60\u4e0e\u603b\u7ed3\uff0c\u4e86\u89e3\u6587\u7ae0\u7684\u57fa\u672c\u5199\u6cd5\u3002</li> </ul>"},{"location":"course/example/","title":"\u793a\u4f8b\u8bfe\u7a0b\uff1a\u5982\u4f55\u6574\u7406\u4e00\u7bc7\u5b66\u4e60\u7b14\u8bb0","text":"<p>\u65e5\u671f\uff1a2026-11-22 \u00b7 \u5206\u7c7b\uff1a\u5b66\u4e60\u65b9\u6cd5</p> <p>\u8fd9\u662f\u4e00\u7bc7\u793a\u4f8b\u6587\u7ae0\u3002\u4ee5\u540e\u5199\u65b0\u6587\u7ae0\u65f6\uff0c\u53ef\u4ee5\u590d\u5236\u8fd9\u4e2a\u6587\u4ef6\uff0c\u518d\u66ff\u6362\u6807\u9898\u548c\u6b63\u6587\u3002</p>"},{"location":"course/example/#_2","title":"\u5b66\u4e60\u76ee\u6807","text":"<p>\u8bfb\u5b8c\u8fd9\u7bc7\u6587\u7ae0\uff0c\u4f60\u5c06\u4e86\u89e3\u5982\u4f55\u7528 Markdown \u5199\u6807\u9898\u3001\u5217\u8868\u3001\u94fe\u63a5\u548c\u4ee3\u7801\u3002</p>"},{"location":"course/example/#_3","title":"\u8bfe\u7a0b\u5185\u5bb9","text":""},{"location":"course/example/#1","title":"1. \u5199\u6e05\u695a\u6838\u5fc3\u6982\u5ff5","text":"<p>\u7528\u81ea\u5df1\u7684\u8bdd\u89e3\u91ca\u4eca\u5929\u5b66\u5230\u7684\u77e5\u8bc6\u3002\u6bb5\u843d\u4e4b\u95f4\u7a7a\u4e00\u884c\uff0c\u5c31\u80fd\u5206\u6210\u4e0d\u540c\u7684\u6bb5\u843d\u3002</p> <p>\u53ef\u4ee5\u7528 \u52a0\u7c97 \u6807\u8bb0\u91cd\u70b9\uff0c\u7528 \u659c\u4f53 \u6dfb\u52a0\u8865\u5145\u8bf4\u660e\u3002</p>"},{"location":"course/example/#2","title":"2. \u7528\u5217\u8868\u6574\u7406\u6b65\u9aa4","text":"<ol> <li>\u9605\u8bfb\u8bfe\u7a0b\u6750\u6599\u3002</li> <li>\u6574\u7406\u91cd\u8981\u77e5\u8bc6\u70b9\u3002</li> <li>\u5b8c\u6210\u4e00\u4e2a\u5c0f\u7ec3\u4e60\u3002</li> <li>\u56de\u987e\u5e76\u5199\u4e0b\u81ea\u5df1\u7684\u7406\u89e3\u3002</li> </ol>"},{"location":"course/example/#3","title":"3. \u8bb0\u5f55\u793a\u4f8b\u4ee3\u7801","text":"<p>\u4ee3\u7801\u653e\u5728\u4e09\u4e2a\u53cd\u5f15\u53f7\u4e4b\u95f4\uff0c\u540e\u9762\u5199\u4e0a\u8bed\u8a00\u540d\u79f0\u3002\u4f8b\u5982\uff1a</p> <pre><code>print(\"\u4f60\u597d\uff0c\u6b22\u8fce\u6765\u5230 ovino\uff01\")\n</code></pre> <p>\u5199\u4f5c\u5c0f\u63d0\u793a</p> <p>\u4e0d\u5fc5\u4e00\u6b21\u5199\u5f97\u5f88\u5b8c\u6574\u3002\u5148\u8bb0\u4e0b\u4eca\u5929\u5b66\u5230\u7684\u4e00\u70b9\u5185\u5bb9\uff0c\u518d\u6162\u6162\u8865\u5145\u3002</p>"},{"location":"course/example/#_4","title":"\u8bfe\u540e\u7ec3\u4e60","text":"<ul> <li>\u7528\u4e00\u53e5\u8bdd\u603b\u7ed3\u4eca\u5929\u7684\u6536\u83b7\u3002</li> <li>\u5199\u51fa\u4e00\u4e2a\u8fd8\u6ca1\u6709\u5f04\u61c2\u7684\u95ee\u9898\u3002</li> <li>\u8bd5\u7740\u628a\u77e5\u8bc6\u5e94\u7528\u5230\u81ea\u5df1\u7684\u5c0f\u9879\u76ee\u4e2d\u3002</li> </ul>"},{"location":"course/example/#_5","title":"\u603b\u7ed3","text":"<p>\u597d\u7684\u5b66\u4e60\u7b14\u8bb0\u53ef\u4ee5\u5305\u542b\uff1a\u5b66\u4e60\u76ee\u6807\u3001\u6838\u5fc3\u5185\u5bb9\u3001\u793a\u4f8b\u3001\u7ec3\u4e60\u548c\u603b\u7ed3\u3002</p>"},{"location":"course/example/#_6","title":"\u53c2\u8003\u8d44\u6599","text":"<ul> <li>Python \u5b98\u65b9\u4e2d\u6587\u6559\u7a0b</li> </ul> <p>\u8fd4\u56de\u8bfe\u7a0b\u5217\u8868</p>"},{"location":"friends/","title":"\u53cb\u94fe","text":"<p>\u8fd9\u91cc\u6536\u85cf\u670b\u53cb\u7684\u7f51\u7ad9\u548c\u6211\u559c\u6b22\u7684\u5b66\u4e60\u8d44\u6e90\u3002\u4e0b\u9762\u662f\u793a\u4f8b\u94fe\u63a5\uff0c\u53ef\u4ee5\u968f\u65f6\u66ff\u6362\u3002</p> <ul> <li>\u793a\u4f8b\u670b\u53cb\u7684\u5c0f\u7ad9 \u2014 \u670b\u53cb\u7684\u7f51\u7ad9\u5360\u4f4d\u94fe\u63a5\u3002</li> <li>Python \u4e2d\u6587\u6587\u6863 \u2014 \u5b66\u4e60 Python \u65f6\u53ef\u4ee5\u67e5\u9605\u7684\u8d44\u6599\u3002</li> </ul>"},{"location":"journey/footprints/","title":"\u8db3\u8ff9","text":"<p>\u8bb0\u4e0b\u53bb\u8fc7\u7684\u5730\u65b9\u3001\u7ecf\u5386\u7684\u4e8b\u60c5\uff0c\u56de\u5934\u770b\u770b\u81ea\u5df1\u4e00\u8def\u8d70\u6765\u7684\u6a21\u6837\u3002</p>"},{"location":"journey/footprints/#_2","title":"\u8db3\u8ff9\u8bb0\u5f55","text":"<p>\u4e0b\u4e00\u6bb5\u503c\u5f97\u7eaa\u5ff5\u7684\u7ecf\u5386\uff0c\u5c31\u4ece\u8fd9\u91cc\u5f00\u59cb\u8bb0\u5f55\u3002</p>"},{"location":"journey/notes/","title":"\u968f\u8bb0","text":"<p>\u8bb0\u5f55\u751f\u6d3b\u91cc\u7684\u7247\u523b\u3001\u7a81\u7136\u5192\u51fa\u7684\u5ff5\u5934\uff0c\u4ee5\u53ca\u90a3\u4e9b\u60f3\u7559\u4e0b\u7684\u8bdd\u3002</p>"},{"location":"journey/notes/#_2","title":"\u968f\u8bb0\u5217\u8868","text":"<p>\u8fd9\u91cc\u7b49\u5f85\u7b2c\u4e00\u7bc7\u968f\u8bb0\u3002</p>"},{"location":"journey/study/","title":"\u4eca\u65e5\u5927\u5b66\u4e60","text":"<p>\u628a\u6bcf\u5929\u5b66\u5230\u7684\u65b0\u77e5\u8bc6\u3001\u8bfb\u5230\u7684\u597d\u5185\u5bb9\u548c\u81ea\u5df1\u7684\u7406\u89e3\uff0c\u6162\u6162\u8bb0\u5f55\u5728\u8fd9\u91cc\u3002</p>"},{"location":"journey/study/#_2","title":"\u5b66\u4e60\u8bb0\u5f55","text":"<ul> <li>\u4eca\u5929\u5b66\u4e60\u4e86 Markdown \u2014 2026\u5e7411\u670824\u65e5 \u00b7 \u793a\u4f8b\u5b66\u4e60\u8bb0\u5f55</li> </ul>"},{"location":"journey/study/2026-11-24/","title":"\u4eca\u5929\u5b66\u4e60\u4e86 Markdown","text":"<p>\u65e5\u671f\uff1a2026\u5e7411\u670824\u65e5</p> <p>\u8fd9\u662f\u4e00\u7bc7\u793a\u4f8b\u5b66\u4e60\u8bb0\u5f55\uff0c\u7528\u6765\u5c55\u793a\u6587\u7ae0\u7684\u5199\u6cd5\u548c\u9875\u9762\u6548\u679c\u3002\u4f60\u53ef\u4ee5\u968f\u65f6\u66ff\u6362\u6210\u81ea\u5df1\u7684\u5185\u5bb9\u3002</p>"},{"location":"journey/study/2026-11-24/#_1","title":"\u4eca\u5929\u5b66\u4e86\u4ec0\u4e48","text":"<p>\u4eca\u5929\u5b66\u4e60\u4e86\u5982\u4f55\u7528 Markdown \u5199\u6587\u7ae0\u3002</p> <ul> <li>\u7528\u4e95\u53f7\u8868\u793a\u6807\u9898</li> <li>\u7528\u5217\u8868\u6574\u7406\u77e5\u8bc6\u70b9</li> <li>\u7528 \u52a0\u7c97 \u7a81\u51fa\u91cd\u70b9</li> </ul>"},{"location":"journey/study/2026-11-24/#_2","title":"\u6211\u7684\u7406\u89e3","text":"<p>Markdown \u53ef\u4ee5\u8ba9\u5199\u6587\u7ae0\u53d8\u5f97\u7b80\u5355\uff1a\u5148\u628a\u60f3\u8bf4\u7684\u8bdd\u5199\u4e0b\u6765\uff0c\u518d\u7528\u6807\u9898\u548c\u5217\u8868\u6574\u7406\u6e05\u695a\u3002</p> <p>\u6bb5\u843d\u4e4b\u95f4\u7a7a\u4e00\u884c\uff0c\u5c31\u80fd\u8ba9\u6587\u7ae0\u66f4\u5bb9\u6613\u9605\u8bfb\u3002\u8bb0\u5f55\u5b66\u4e60\u5185\u5bb9\u65f6\uff0c\u4e5f\u53ef\u4ee5\u5199\u4e0b\u81ea\u5df1\u7684\u7591\u95ee\uff0c\u7559\u5f85\u4ee5\u540e\u56de\u987e\u3002</p>"},{"location":"journey/study/2026-11-24/#_3","title":"\u4e0b\u4e00\u6b65\u8ba1\u5212","text":"<p>\u660e\u5929\u5c1d\u8bd5\u5728\u6587\u7ae0\u4e2d\u6dfb\u52a0\u56fe\u7247\uff0c\u5e76\u7ee7\u7eed\u8bb0\u5f55\u65b0\u7684\u5b66\u4e60\u6536\u83b7\u3002</p> <p>\u8fd4\u56de\u4eca\u65e5\u5927\u5b66\u4e60</p>"}]}